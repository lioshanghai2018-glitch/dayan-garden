.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 40px;
}

.logo-section {
  text-align: center;
  margin-bottom: 60px;
}

.logo {
  font-size: 80px;
  margin-bottom: 16px;
}

.app-name {
  display: block;
  font-size: 28px;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8px;
}

.app-slogan {
  display: block;
  font-size: 14px;
  color: rgba(255, 255, 255, 0.8);
}

.login-section {
  width: 100%;
}

.btn-login {
  width: 100%;
  background: #FFFFFF;
  color: #2E7D32;
  border-radius: 25px;
  font-size: 16px;
  font-weight: 500;
  padding: 14px 0;
  margin-bottom: 16px;
}

.btn-login::after {
  border: none;
}

.login-hint {
  display: block;
  text-align: center;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.6);
}