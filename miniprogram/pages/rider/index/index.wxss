.container {
  padding: 0;
  background: #F5F5F5;
  min-height: 100vh;
}

.rider-header {
  background: linear-gradient(135deg, #FF6B35 0%, #FF8F5A 100%);
  padding: 20px 16px;
  display: flex;
  align-items: center;
}

.rider-avatar {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: #FFFFFF;
}

.rider-info {
  flex: 1;
  margin-left: 16px;
}

.rider-name {
  display: block;
  font-size: 18px;
  font-weight: 600;
  color: #FFFFFF;
}

.rider-status {
  display: block;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4px;
}

.today-stats {
  display: flex;
  background: #FFFFFF;
  padding: 16px;
  margin-bottom: 12px;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 24px;
  font-weight: 600;
  color: #FF6B35;
}

.stat-label {
  display: block;
  font-size: 12px;
  color: #999999;
  margin-top: 4px;
}

.order-section {
  background: #FFFFFF;
  margin-bottom: 12px;
}

.section-header {
  padding: 12px 16px;
  border-bottom: 1px solid #F5F5F5;
}

.section-title {
  font-size: 14px;
  font-weight: 500;
  color: #333333;
}

.order-list {
  padding: 12px 16px;
}

.order-card {
  background: #FAFAFA;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 12px;
}

.order-info {
  margin-bottom: 12px;
}

.order-no {
  display: block;
  font-size: 14px;
  font-weight: 500;
  color: #333333;
}

.order-address {
  display: block;
  font-size: 13px;
  color: #666666;
  margin-top: 8px;
}

.order-contact {
  display: block;
  font-size: 12px;
  color: #999999;
  margin-top: 4px;
}

.order-actions {
  display: flex;
  gap: 12px;
}

.action-btn {
  flex: 1;
  height: 36px;
  line-height: 36px;
  text-align: center;
  background: #FFFFFF;
  border: 1px solid #FF6B35;
  color: #FF6B35;
  border-radius: 18px;
  font-size: 14px;
}

.action-btn.primary {
  background: #FF6B35;
  color: #FFFFFF;
}

.empty-tip {
  text-align: center;
  padding: 20px;
  color: #999999;
  font-size: 14px;
}