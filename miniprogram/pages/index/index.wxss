.container {
  padding: 0;
}

/* 截单提示横幅 */
.cutoff-banner {
  background: #FFF3E0;
  color: #E65100;
  text-align: center;
  padding: 8px;
  font-size: 13px;
}

/* 搜索栏 */
.search-bar {
  margin: 12px 16px;
  padding: 10px 16px;
  background: #FFFFFF;
  border-radius: 20px;
  display: flex;
  align-items: center;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.search-placeholder {
  color: #999999;
  font-size: 14px;
  width: 100%;
}

/* 轮播图 */
.banner-section {
  padding: 0 16px;
}

.banner-section swiper {
  height: 180px;
  border-radius: 8px;
}

.banner-img {
  width: 100%;
  height: 100%;
}

/* 分类导航 */
.category-nav {
  padding: 16px 0;
}

.category-scroll {
  white-space: nowrap;
  padding: 0 16px;
}

.category-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 20px;
  width: 60px;
}

.category-item.active .category-name {
  color: #2E7D32;
}

.category-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #E8F5E9;
  margin-bottom: 8px;
}

.category-name {
  font-size: 12px;
  color: #666666;
}

/* 商品列表 */
.product-section {
  padding: 0 16px;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333333;
}

.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-item {
  width: 48%;
  background: #FFFFFF;
  border-radius: 8px;
  margin-bottom: 12px;
  position: relative;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.product-image {
  width: 100%;
  height: 160px;
  border-radius: 8px 8px 0 0;
  background: #F5F5F5;
}

.product-info {
  padding: 12px;
}

.product-name {
  font-size: 14px;
  font-weight: 500;
  color: #333333;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-subtitle {
  font-size: 12px;
  color: #999999;
  display: block;
  margin-top: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-bottom {
  display: flex;
  align-items: baseline;
  margin-top: 8px;
}

.product-unit {
  font-size: 12px;
  color: #999999;
  margin-left: 4px;
}

.product-tags {
  display: flex;
  margin-top: 8px;
}

.tag {
  display: inline-block;
  padding: 2px 6px;
  background: #E8F5E9;
  color: #2E7D32;
  border-radius: 4px;
  font-size: 10px;
  margin-right: 4px;
}

.add-btn {
  position: absolute;
  bottom: 12px;
  right: 12px;
  width: 28px;
  height: 28px;
  background: #2E7D32;
  color: #FFFFFF;
  border-radius: 50%;
  text-align: center;
  line-height: 28px;
  font-size: 18px;
}

.add-btn:active {
  background: #1B5E20;
}

.load-more, .no-more {
  text-align: center;
  padding: 20px;
  color: #999999;
  font-size: 12px;
}