<view class="container">
  <!-- 截单提示横幅 -->
  <view class="cutoff-banner" wx:if="{{isCutoff}}">
    <text>今日已截单，下单后明天送达</text>
  </view>

  <!-- 搜索栏 -->
  <view class="search-bar" bindtap="goToSearch">
    <text class="search-placeholder">搜索蔬菜、水果...</text>
  </view>

  <!-- 轮播图 -->
  <view class="banner-section">
    <swiper indicator-dots autoplay circular interval="3000">
      <block wx:for="{{banners}}" wx:key="id">
        <swiper-item>
          <image src="{{item.image}}" mode="aspectFill" class="banner-img" />
        </swiper-item>
      </block>
    </swiper>
  </view>

  <!-- 分类导航 -->
  <view class="category-nav">
    <scroll-view scroll-x class="category-scroll">
      <view class="category-item {{categoryId === item.id ? 'active' : ''}}"
            wx:for="{{categories}}" wx:key="id"
            bindtap="selectCategory" data-id="{{item.id}}">
        <image class="category-icon" src="{{item.icon || '/static/default.png'}}" mode="aspectFit" />
        <text class="category-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 商品列表 -->
  <view class="product-section">
    <view class="section-header">
      <text class="section-title">推荐商品</text>
    </view>
    <view class="product-grid">
      <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
        <image class="product-image" src="{{item.image || '/static/placeholder.png'}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-subtitle">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="price">
              <text class="price-integer">¥{{item.price}}</text>
            </view>
            <text class="product-unit">{{item.unit}}</text>
          </view>
          <view class="product-tags">
            <text class="tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tag">{{tag}}</text>
          </view>
        </view>
        <view class="add-btn" catchtap="addToCart" data-id="{{item.id}}">+</view>
      </view>
    </view>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text>加载中...</text>
  </view>
  <view class="no-more" wx:else>
    <text>没有更多了</text>
  </view>
</view>