<view class="container">
  <!-- 左侧分类 -->
  <view class="category-left">
    <scroll-view scroll-y class="category-list">
      <view class="category-item {{activeCategory === item.id ? 'active' : ''}}"
            wx:for="{{categories}}" wx:key="id"
            bindtap="selectCategory" data-id="{{item.id}}">
        <text>{{item.name}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- 右侧商品 -->
  <view class="product-right">
    <scroll-view scroll-y class="product-list">
      <view class="product-item" wx:for="{{products}}" wx:key="id"
            bindtap="goToDetail" data-id="{{item.id}}">
        <image class="product-image" src="{{item.image || '/static/placeholder.png'}}" mode="aspectFill" />
        <view class="product-info">
          <text class="product-name">{{item.name}}</text>
          <text class="product-subtitle">{{item.subtitle}}</text>
          <view class="product-bottom">
            <view class="price">
              <text class="price-integer">¥{{item.price}}</text>
            </view>
            <text class="product-unit">{{item.unit}}</text>
          </view>
        </view>
        <view class="add-btn" catchtap="addToCart" data-id="{{item.id}}">+</view>
      </view>

      <view class="empty-state" wx:if="{{products.length === 0}}">
        <text>该分类暂无商品</text>
      </view>
    </scroll-view>
  </view>
</view>