.container {
  padding-bottom: 80px;
}

.product-image {
  width: 100%;
  height: 300px;
  background: #F5F5F5;
}

.product-image image {
  width: 100%;
  height: 100%;
}

.card {
  margin: 12px 16px;
  background: #FFFFFF;
  border-radius: 8px;
  padding: 16px;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 8px;
}

.product-name {
  font-size: 18px;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 4px;
}

.product-subtitle {
  font-size: 14px;
  color: #666666;
  display: block;
  margin-bottom: 12px;
}

.product-meta {
  display: flex;
  gap: 16px;
  font-size: 12px;
  color: #999999;
  margin-bottom: 12px;
}

.product-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.tag {
  display: inline-block;
  padding: 2px 8px;
  background: #E8F5E9;
  color: #2E7D32;
  border-radius: 4px;
  font-size: 12px;
}

.section-title {
  font-size: 16px;
  font-weight: 500;
  margin-bottom: 12px;
  display: block;
}

.desc-content {
  font-size: 14px;
  color: #666666;
  line-height: 1.6;
  display: block;
}

/* 底部购买栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 0 16px;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
}

.cart-icon {
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  margin-right: 16px;
}

.btn-group {
  flex: 1;
  display: flex;
  gap: 12px;
}

.btn-add-cart, .btn-buy {
  flex: 1;
  height: 40px;
  line-height: 40px;
  text-align: center;
  border-radius: 20px;
  font-size: 14px;
  font-weight: 500;
}

.btn-add-cart {
  background: #FFFFFF;
  color: #2E7D32;
  border: 1px solid #2E7D32;
}

.btn-buy {
  background: #2E7D32;
  color: #FFFFFF;
}

/* 数量选择弹窗 */
.quantity-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 100;
}

.modal-content {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16px 16px 0 0;
  padding: 24px;
}

.modal-title {
  font-size: 16px;
  font-weight: 600;
  display: block;
  text-align: center;
  margin-bottom: 24px;
}

.quantity-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24px;
}

.quantity-label {
  font-size: 14px;
  color: #666666;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 32px;
  height: 32px;
  background: #F5F5F5;
  border-radius: 50%;
  text-align: center;
  line-height: 32px;
  font-size: 16px;
}

.qty-value {
  padding: 0 16px;
  font-size: 16px;
}

.modal-btns {
  display: flex;
}

.btn-primary {
  flex: 1;
  height: 44px;
  background: #2E7D32;
  color: #FFFFFF;
  border-radius: 8px;
  text-align: center;
  line-height: 44px;
  font-size: 16px;
}