.container {
  padding: 0;
}

.user-info {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #2E7D32 0%, #4CAF50 100%);
  padding: 32px 20px;
}

.avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: #FFFFFF;
}

.user-detail {
  margin-left: 16px;
}

.nickname {
  display: block;
  font-size: 18px;
  font-weight: 500;
  color: #FFFFFF;
}

.user-role {
  display: inline-block;
  margin-top: 4px;
  padding: 2px 8px;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 10px;
  font-size: 12px;
  color: #FFFFFF;
}

.menu-list {
  margin: 12px 0;
}

.menu-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16px 20px;
  border-bottom: 1px solid #F5F5F5;
}

.menu-icon {
  font-size: 20px;
  margin-right: 12px;
}

.menu-text {
  flex: 1;
  font-size: 14px;
  color: #333333;
}

.menu-arrow {
  font-size: 16px;
  color: #CCCCCC;
}

.logout-btn {
  margin: 24px 20px;
  padding: 14px;
  background: #FFFFFF;
  text-align: center;
  color: #F5222D;
  font-size: 16px;
  border-radius: 8px;
}