.container {
  padding-bottom: 120px;
}

.cart-list {
  padding: 12px 16px;
}

.cart-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 8px;
  padding: 12px;
  margin-bottom: 12px;
  position: relative;
}

.cart-check {
  width: 24px;
  height: 24px;
  border: 1px solid #E8E8E8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 12px;
  font-size: 12px;
  color: #FFFFFF;
}

.cart-check .checked {
  background: #2E7D32;
  border-color: #2E7D32;
}

.cart-image {
  width: 80px;
  height: 80px;
  border-radius: 8px;
  background: #F5F5F5;
}

.cart-info {
  flex: 1;
  margin-left: 12px;
}

.cart-name {
  font-size: 14px;
  font-weight: 500;
  color: #333333;
  display: block;
}

.cart-unit {
  font-size: 12px;
  color: #999999;
  display: block;
  margin-top: 4px;
}

.cart-bottom {
  display: flex;
  align-items: center;
  margin-top: 8px;
  justify-content: space-between;
}

.quantity-control {
  display: flex;
  align-items: center;
}

.qty-btn {
  width: 24px;
  height: 24px;
  background: #F5F5F5;
  border-radius: 4px;
  text-align: center;
  line-height: 24px;
  font-size: 14px;
}

.qty-value {
  padding: 0 12px;
  font-size: 14px;
}

.delete-btn {
  position: absolute;
  top: 12px;
  right: 12px;
  color: #F5222D;
  font-size: 12px;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60px 20px;
}

.empty-state image {
  width: 120px;
  height: 120px;
  margin-bottom: 20px;
}

.empty-state text {
  display: block;
  color: #999999;
  margin-bottom: 20px;
}

.btn-primary {
  display: inline-block;
  padding: 12px 32px;
  background: #2E7D32;
  color: #FFFFFF;
  border-radius: 20px;
  font-size: 14px;
}

/* 底部结算栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 0 16px;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
}

.select-all {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  color: #666666;
}

.select-all text:first-child {
  width: 20px;
  height: 20px;
  border: 1px solid #E8E8E8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  color: #FFFFFF;
}

.select-all .checked {
  background: #2E7D32;
  border-color: #2E7D32;
}

.total-info {
  flex: 1;
  text-align: right;
  margin-right: 12px;
}

.total-label {
  font-size: 14px;
  color: #666666;
}

.total-price {
  font-size: 18px;
  color: #F5222D;
  font-weight: 600;
}

.checkout-btn {
  background: #2E7D32;
  color: #FFFFFF;
  padding: 0 24px;
  height: 40px;
  line-height: 40px;
  border-radius: 20px;
  font-size: 14px;
}

.checkout-btn.disabled {
  background: #CCCCCC;
}