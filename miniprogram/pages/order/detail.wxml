<view class="container">
  <!-- 订单状态区 -->
  <view class="status-section">
    <text class="status-text {{statusColor}}">{{statusText}}</text>
    <text class="status-hint">{{statusHint}}</text>
  </view>

  <!-- 配送信息卡片 -->
  <view class="order-card">
    <view class="card-title">配送信息</view>
    <view class="info-row" wx:if="{{deliveryTime}}">
      <text class="info-label">配送时段</text>
      <text class="info-value">{{deliveryTime}}</text>
    </view>
    <view class="info-row" wx:if="{{address}}">
      <text class="info-label">收货人</text>
      <text class="info-value">{{address.name}} {{address.phone}}</text>
    </view>
    <view class="info-row" wx:if="{{address}}">
      <text class="info-label">配送地址</text>
      <text class="info-value">{{address.community}} {{address.building}} {{address.room}}</text>
    </view>
  </view>

  <!-- 商品明细卡片 -->
  <view class="order-card">
    <view class="card-title">商品明细</view>
    <view class="item-list">
      <view class="item-row" wx:for="{{items}}" wx:key="index">
        <text class="item-name">{{item.name}} × {{item.quantity}}</text>
        <text class="item-price">¥{{item.subtotal}}</text>
      </view>
    </view>
    <view class="divider"></view>
    <view class="total-row">
      <text class="total-label">合计</text>
      <text class="total-price">¥{{totalAmount}}</text>
    </view>
  </view>

  <!-- 订单信息卡片 -->
  <view class="order-card">
    <view class="card-title">订单信息</view>
    <view class="info-row">
      <text class="info-label">订单编号</text>
      <text class="info-value">{{orderNo}}</text>
    </view>
    <view class="info-row" wx:if="{{createdAt}}">
      <text class="info-label">下单时间</text>
      <text class="info-value">{{createdAt}}</text>
    </view>
    <view class="info-row">
      <text class="info-label">支付方式</text>
      <text class="info-value">货到付款</text>
    </view>
  </view>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{showActions}}">
    <!-- 待支付：可取消、可支付 -->
    <view class="action-btn secondary" wx:if="{{status === 0}}" bindtap="cancelOrder">取消订单</view>
    <view class="action-btn primary" wx:if="{{status === 0}}" bindtap="payOrder">去支付</view>

    <!-- 待接单：可取消、可申请退款 -->
    <view class="action-btn secondary" wx:if="{{status === 1}}" bindtap="cancelOrder">取消订单</view>
    <view class="action-btn outline" wx:if="{{status === 1}}" bindtap="showAftersaleModal">申请退款</view>

    <!-- 已接单：可申请退款 -->
    <view class="action-btn outline" wx:if="{{status === 2}}" bindtap="showAftersaleModal">申请退款</view>

    <!-- 配送中：可申请退款 -->
    <view class="action-btn outline" wx:if="{{status === 4}}" bindtap="showAftersaleModal">申请退款</view>
    <view class="action-btn outline" wx:if="{{status === 4}}" bindtap="callRider">联系骑手</view>

    <!-- 已完成：可申请退款 -->
    <view class="action-btn outline" wx:if="{{status === 6}}" bindtap="showAftersaleModal">申请售后</view>

    <!-- 已取消/已退款：显示再来一单 -->
    <view class="action-btn primary" wx:if="{{status === 7 || status === 9}}" bindtap="reOrder">再来一单</view>
  </view>
</view>

<!-- 售后申请弹窗 -->
<view class="modal" wx:if="{{showAftersaleModal}}" bindtap="hideAftersaleModal">
  <view class="modal-content" catchtap="stopProp">
    <view class="modal-header">
      <text class="modal-title">申请售后</text>
      <text class="modal-close" bindtap="hideAftersaleModal">×</text>
    </view>

    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">售后类型</text>
        <view class="type-selector">
          <view class="type-option {{aftersaleType === 1 ? 'selected' : ''}}" bindtap="selectAftersaleType" data-type="1">
            <text>退货退款</text>
          </view>
          <view class="type-option {{aftersaleType === 2 ? 'selected' : ''}}" bindtap="selectAftersaleType" data-type="2">
            <text>仅退款</text>
          </view>
        </view>
      </view>

      <view class="form-item">
        <text class="form-label">退款原因</text>
        <textarea class="form-textarea" placeholder="请输入退款原因（必填）" maxlength="500" bindinput="inputReason" value="{{aftersaleReason}}"></textarea>
      </view>

      <view class="form-item">
        <text class="form-label">上传凭证（可选）</text>
        <view class="image-upload-list">
          <view class="image-item" wx:for="{{aftersaleImages}}" wx:key="index">
            <image src="{{item}}" mode="aspectFill"></image>
            <view class="image-remove" bindtap="removeAftersaleImage" data-index="{{index}}">×</view>
          </view>
          <view class="image-add" bindtap="chooseAftersaleImage" wx:if="{{aftersaleImages.length < 3}}">
            <text>+</text>
            <text class="image-add-hint">添加图片</text>
          </view>
        </view>
      </view>
    </view>

    <view class="modal-footer">
      <button class="btn-cancel" bindtap="hideAftersaleModal">取消</button>
      <button class="btn-confirm" bindtap="submitAftersale">提交申请</button>
    </view>
  </view>
</view>

<style>
/* 现有样式保持不变 */
.status-section {
  background: linear-gradient(135deg, #2E7D32, #4CAF50);
  padding: 30rpx;
  color: #fff;
}
.status-text {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
  margin-bottom: 10rpx;
}
.status-hint {
  font-size: 24rpx;
  opacity: 0.9;
}
.order-card {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.card-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #eee;
}
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}
.info-label {
  color: #666;
  font-size: 26rpx;
}
.info-value {
  color: #333;
  font-size: 26rpx;
}
.item-list {
  padding: 10rpx 0;
}
.item-row {
  display: flex;
  justify-content: space-between;
  padding: 10rpx 0;
}
.item-name {
  color: #333;
  font-size: 26rpx;
  flex: 1;
}
.item-price {
  color: #666;
  font-size: 26rpx;
}
.divider {
  height: 1rpx;
  background: #eee;
  margin: 16rpx 0;
}
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.total-label {
  color: #666;
  font-size: 28rpx;
}
.total-price {
  color: #FF6B00;
  font-size: 32rpx;
  font-weight: bold;
}
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.05);
}
.action-btn {
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
}
.action-btn.primary {
  background: #2E7D32;
  color: #fff;
}
.action-btn.secondary {
  background: #f5f5f5;
  color: #666;
}
.action-btn.outline {
  border: 2rpx solid #2E7D32;
  color: #2E7D32;
  background: #fff;
}

/* 售后弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}
.modal-content {
  background: #fff;
  width: 100%;
  border-radius: 24rpx 24rpx 0 0;
  max-height: 85vh;
  overflow-y: auto;
}
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.modal-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}
.modal-body {
  padding: 30rpx;
}
.form-item {
  margin-bottom: 30rpx;
}
.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}
.type-selector {
  display: flex;
  gap: 20rpx;
}
.type-option {
  flex: 1;
  padding: 20rpx;
  border: 2rpx solid #ddd;
  border-radius: 12rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
}
.type-option.selected {
  border-color: #2E7D32;
  background: #E8F5E9;
  color: #2E7D32;
}
.form-textarea {
  width: 100%;
  height: 160rpx;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}
.image-upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.image-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}
.image-item image {
  width: 100%;
  height: 100%;
}
.image-remove {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #999;
}
.image-add-hint {
  font-size: 22rpx;
  margin-top: 8rpx;
}
.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 30rpx;
  border-top: 1rpx solid #eee;
}
.btn-cancel, .btn-confirm {
  flex: 1;
  padding: 24rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  border: none;
}
.btn-cancel {
  background: #f5f5f5;
  color: #666;
}
.btn-confirm {
  background: #2E7D32;
  color: #fff;
}
</style>