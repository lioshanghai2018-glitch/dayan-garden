.container {
  padding: 20px 16px;
  min-height: 100vh;
  background: #F5F5F5;
}

.success-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40px 0 30px;
}

.success-icon {
  width: 64px;
  height: 64px;
  background: #2E7D32;
  color: #FFFFFF;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32px;
  margin-bottom: 16px;
}

.success-title {
  font-size: 22px;
  font-weight: 600;
  color: #333333;
}

.delivery-hint {
  background: #E8F5E9;
  color: #2E7D32;
  text-align: center;
  padding: 12px;
  border-radius: 8px;
  font-size: 14px;
  margin-bottom: 20px;
}

.order-card {
  background: #FFFFFF;
  border-radius: 12px;
  padding: 16px;
  margin-bottom: 100px;
}

.order-info {
  margin-bottom: 12px;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 8px 0;
}

.info-label {
  font-size: 14px;
  color: #999999;
}

.info-value {
  font-size: 14px;
  color: #333333;
}

.divider {
  height: 1px;
  background: #F5F5F5;
  margin: 12px 0;
}

.item-list {
  margin-bottom: 12px;
}

.item-row {
  display: flex;
  justify-content: space-between;
  padding: 6px 0;
}

.item-name {
  font-size: 14px;
  color: #333333;
  flex: 1;
}

.item-price {
  font-size: 14px;
  color: #333333;
  margin-left: 16px;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 8px;
}

.total-label {
  font-size: 14px;
  color: #333333;
}

.total-price {
  font-size: 18px;
  color: #F5222D;
  font-weight: 600;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 16px;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.auto-back {
  font-size: 12px;
  color: #999999;
  margin-bottom: 8px;
}

.back-btn {
  width: 100%;
  padding: 14px;
  background: #2E7D32;
  color: #FFFFFF;
  text-align: center;
  font-size: 16px;
  border-radius: 8px;
}