<view class="container">
  <!-- 订单状态Tab -->
  <view class="status-tabs">
    <view class="tab-item {{status === null ? 'active' : ''}}" bindtap="switchTab" data-status="">
      全部
    </view>
    <view class="tab-item {{status === 0 ? 'active' : ''}}" bindtap="switchTab" data-status="0">待支付</view>
    <view class="tab-item {{status === 1 || status === 2 ? 'active' : ''}}" bindtap="switchTab" data-status="1">待接单</view>
    <view class="tab-item {{status === 4 ? 'active' : ''}}" bindtap="switchTab" data-status="4">配送中</view>
    <view class="tab-item {{status === 6 ? 'active' : ''}}" bindtap="switchTab" data-status="6">已完成</view>
  </view>

  <!-- 订单列表 -->
  <view class="order-list">
    <view class="order-item" wx:for="{{orders}}" wx:key="id" bindtap="goToDetail" data-id="{{item.id}}">
      <view class="order-header">
        <text class="order-no">订单号: {{item.order_no}}</text>
        <text class="order-status" style="color: {{item.statusColor}}">{{item.statusText}}</text>
      </view>
      <view class="order-content">
        <view class="order-items-preview">
          <text wx:for="{{item.items}}" wx:key="*this" wx:for-item="orderItem">{{orderItem.name}}{{orderItem.quantity > 1 ? ' x' + orderItem.quantity : ''}}{{index < item.items.length - 1 ? ', ' : ''}}</text>
        </view>
        <text class="order-total">共{{item.item_count}}件 合计: ¥{{item.pay_amount}}</text>
      </view>
      <view class="order-footer">
        <text class="order-time">{{item.created_at}}</text>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
      <text>暂无订单</text>
    </view>

    <!-- 加载中状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>
  </view>
</view>