.container {
  padding-bottom: 20px;
}

.status-tabs {
  display: flex;
  background: #FFFFFF;
  padding: 12px 16px;
  margin-bottom: 12px;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 8px 0;
  font-size: 14px;
  color: #666666;
  position: relative;
}

.tab-item.active {
  color: #2E7D32;
  font-weight: 500;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 24px;
  height: 2px;
  background: #2E7D32;
  border-radius: 1px;
}

.order-list {
  padding: 0 16px;
}

.order-item {
  background: #FFFFFF;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 12px;
}

.order-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12px;
}

.order-no {
  font-size: 12px;
  color: #999999;
}

.order-status {
  font-size: 14px;
  font-weight: 500;
}

.order-content {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 12px;
}

.order-items-preview {
  flex: 1;
  font-size: 14px;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-total {
  font-size: 14px;
  color: #333333;
  white-space: nowrap;
}

.order-footer {
  display: flex;
  justify-content: flex-end;
}

.order-time {
  font-size: 12px;
  color: #999999;
}

.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: #999999;
}