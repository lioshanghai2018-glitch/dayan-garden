.container {
  padding-bottom: 80px;
}

/* 收货地址 */
.address-section {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  padding: 16px;
  margin-bottom: 12px;
}

.address-info {
  flex: 1;
}

.address-detail {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 8px;
}

.address-name {
  font-size: 16px;
  font-weight: 500;
}

.address-phone {
  font-size: 14px;
  color: #666666;
}

.address-text {
  font-size: 14px;
  color: #999999;
}

.address-empty {
  flex: 1;
  color: #F5222D;
}

.arrow {
  font-size: 20px;
  color: #CCCCCC;
}

/* 配送时间段 */
.slot-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 12px;
}

.slot-list.horizontal {
  flex-wrap: nowrap;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.slot-list.horizontal .slot-item {
  flex-shrink: 0;
}

.slot-item {
  padding: 8px 16px;
  background: #F5F5F5;
  border-radius: 4px;
  font-size: 14px;
}

.slot-item.active {
  background: #E8F5E9;
  color: #2E7D32;
}

.slot-loading {
  margin-top: 12px;
  color: #999999;
  font-size: 14px;
}

/* 商品清单 */
.item-row {
  display: flex;
  align-items: center;
  padding: 12px 0;
  border-bottom: 1px solid #F5F5F5;
}

.item-image {
  width: 60px;
  height: 60px;
  border-radius: 8px;
  background: #F5F5F5;
}

.item-info {
  flex: 1;
  margin-left: 12px;
}

.item-name {
  font-size: 14px;
  display: block;
}

.item-unit {
  font-size: 12px;
  color: #999999;
  display: block;
  margin-top: 4px;
}

.item-price {
  text-align: right;
}

.item-price text:first-child {
  font-size: 14px;
  color: #333333;
}

.item-qty {
  display: block;
  font-size: 12px;
  color: #999999;
  margin-top: 4px;
}

/* 备注 */
.remark-input {
  margin-top: 12px;
  padding: 12px;
  background: #F5F5F5;
  border-radius: 8px;
  font-size: 14px;
}

/* 底部支付栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60px;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 0 16px;
  box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.06);
}

.total-info {
  flex: 1;
}

.total-label {
  font-size: 14px;
  color: #666666;
}

.total-price {
  font-size: 20px;
  color: #F5222D;
  font-weight: 600;
}

.pay-btn {
  background: #2E7D32;
  color: #FFFFFF;
  padding: 0 32px;
  height: 44px;
  line-height: 44px;
  border-radius: 22px;
  font-size: 16px;
}