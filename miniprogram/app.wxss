/* 全局样式 */
page {
  background-color: #FAFAF5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 14px;
  color: #333333;
}

.container {
  min-height: 100vh;
  padding: 16px;
}

/* 通用按钮 */
.btn-primary {
  background: #2E7D32;
  color: #FFFFFF;
  border-radius: 8px;
  height: 44px;
  line-height: 44px;
  font-size: 16px;
  font-weight: 500;
  text-align: center;
  border: none;
}

.btn-primary:active {
  background: #1B5E20;
}

.btn-secondary {
  background: #FFFFFF;
  color: #2E7D32;
  border: 1px solid #2E7D32;
  border-radius: 8px;
  height: 44px;
  line-height: 44px;
  font-size: 16px;
  font-weight: 500;
  text-align: center;
}

.btn-disabled {
  background: #CCCCCC;
  color: #FFFFFF;
  border-radius: 8px;
  height: 44px;
  line-height: 44px;
  font-size: 16px;
  font-weight: 500;
  text-align: center;
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 8px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

/* 价格样式 */
.price {
  color: #F5222D;
  font-weight: 600;
}

.price-unit {
  font-size: 12px;
}

.price-integer {
  font-size: 18px;
}

.price-decimal {
  font-size: 12px;
}

.original-price {
  color: #999999;
  text-decoration: line-through;
  font-size: 12px;
  margin-left: 8px;
}

/* 标签 */
.tag {
  display: inline-block;
  padding: 2px 8px;
  background: #E8F5E9;
  color: #2E7D32;
  border-radius: 4px;
  font-size: 12px;
}

/* 分割线 */
.divider {
  height: 1px;
  background: #E8E8E8;
  margin: 12px 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 60px 20px;
  color: #999999;
}

.empty-state image {
  width: 80px;
  height: 80px;
  margin-bottom: 16px;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40px;
  color: #999999;
}

/* 页面标题 */
.page-title {
  font-size: 20px;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16px;
}

/* 模块标题 */
.section-title {
  font-size: 16px;
  font-weight: 500;
  color: #333333;
  margin-bottom: 12px;
}

/* 状态颜色 */
.status-pending { color: #FAAD14; }
.status-processing { color: #1890FF; }
.status-success { color: #52C41A; }
.status-error { color: #F5222D; }

/* 底部安全区 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}